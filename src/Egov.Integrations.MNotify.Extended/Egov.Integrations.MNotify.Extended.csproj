<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet Metadata -->
    <PackageId>Egov.Integrations.MNotify.Extended</PackageId>
    <Authors>egov.md</Authors>
    <Company>egov.md</Company>
    <Description>Extended .NET client library for the MNotify service, adding recipient message history, read state, contact management and language preferences on top of Egov.Integrations.MNotify.</Description>
    <PackageTags>egov;mnotify;integration;notifications;dotnet</PackageTags>
    <RepositoryUrl>https://github.com/egov-moldova/Egov.Integrations.MNotify</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Release notes: https://github.com/egov-moldova/Egov.Integrations.MNotify/blob/master/CHANGELOG.md</PackageReleaseNotes>
    <PackageIcon>MNotify.png</PackageIcon>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>

    <!-- Build settings -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\files\MNotify.png" Pack="true" PackagePath="\" Condition="Exists('..\files\MNotify.png')" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\Egov.Integrations.MNotify\Egov.Integrations.MNotify.csproj" />
  </ItemGroup>

</Project>
